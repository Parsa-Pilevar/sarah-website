# Copy to .env.local and fill in. Never commit a filled-in .env file.

# Sanity project the site reads content from
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional; sanity/env.ts has a pinned default
NEXT_PUBLIC_SANITY_API_VERSION=

# Formspree form id the contact form posts to
NEXT_PUBLIC_FORMSPREE_ID=

# Public origin, no trailing slash. Used by metadataBase, the sitemap and robots.txt.
# Falls back to http://localhost:3000 when unset.
SITE_URL=
